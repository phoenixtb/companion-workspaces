{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "database.dbname": "dispatchly",
  "topic.prefix": "outbox",
  "table.include.list": "public.outbox_event",
  "slot.name": "dispatchly_outbox",
  "publication.name": "dbz_outbox",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "no_data",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "10000",
  "lsn.flush.mode": "connector_and_driver",
  "offset.mismatch.strategy": "trust_greater_lsn",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "3",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.topic.replacement": "dispatchly.${routedByValue}.events",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
  "transforms.outbox.predicate": "isOutboxTable",
  "predicates": "isOutboxTable",
  "predicates.isOutboxTable.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutboxTable.pattern": "outbox\\.public\\.outbox_event"
}
