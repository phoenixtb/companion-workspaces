{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "database.dbname": "dispatchly",
  "topic.prefix": "dispatchly",
  "table.include.list": "public.shipments,public.hubs",
  "slot.name": "dispatchly_shipments",
  "publication.name": "dbz_dispatchly",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "time.precision.mode": "adaptive",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "INSERT INTO debezium_heartbeat (id, beat_at) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET beat_at = EXCLUDED.beat_at",
  "signal.data.collection": "public.debezium_signal",
  "incremental.snapshot.chunk.size": "16",
  "notification.enabled.channels": "log",
  "tombstones.on.delete": "true",
  "column.mask.hash.v2.SHA-256.with.salt.dispatchly-cdc-2026": "public.shipments.customer_phone",
  "exactly.once.support": "required",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.cleanup.policy": "compact",
  "producer.override.compression.type": "zstd"
}
