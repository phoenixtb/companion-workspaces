{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "1",
  "topics": "larkspur.pos.basket-events,larkspur.clickstream.events",
  "consumer.override.isolation.level": "read_committed",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "value.converter.apicurio.registry.url": "http://apicurio:8080/apis/registry/v3",
  "transforms": "kafka",
  "transforms.kafka.type": "org.apache.iceberg.connect.transforms.KafkaMetadataTransform",
  "iceberg.tables.route-field": "_kafka_metadata_topic",
  "iceberg.tables": "stream.pos_basket_events,stream.click_events",
  "iceberg.table.stream.pos_basket_events.route-regex": "larkspur\\.pos\\.basket-events",
  "iceberg.table.stream.click_events.route-regex": "larkspur\\.clickstream\\.events",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.evolve-schema-enabled": "true",
  "iceberg.tables.default-partition-by": "day(event_ts)",
  "iceberg.control.commit.interval-ms": "10000",
  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "http://polaris:8181/api/catalog",
  "iceberg.catalog.oauth2-server-uri": "http://polaris:8181/api/catalog/v1/oauth/tokens",
  "iceberg.catalog.credential": "${env:POLARIS_CREDENTIAL}",
  "iceberg.catalog.scope": "PRINCIPAL_ROLE:ALL",
  "iceberg.catalog.warehouse": "larkspur",
  "iceberg.catalog.header.X-Iceberg-Access-Delegation": "",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
  "iceberg.catalog.s3.endpoint": "http://seaweedfs:8333",
  "iceberg.catalog.s3.path-style-access": "true",
  "iceberg.catalog.s3.access-key-id": "${env:S3_ACCESS_KEY}",
  "iceberg.catalog.s3.secret-access-key": "${env:S3_SECRET_KEY}",
  "iceberg.catalog.client.region": "us-east-1"
}
