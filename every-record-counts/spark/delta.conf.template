spark.master                                local[*]
spark.driver.memory                         1536m
spark.sql.shuffle.partitions                8
spark.sql.session.timeZone                  UTC
spark.jars                                  /opt/lakehouse/delta-jars/*.jar
spark.sql.extensions                        io.delta.sql.DeltaSparkSessionExtension
spark.sql.catalog.spark_catalog             org.apache.spark.sql.delta.catalog.DeltaCatalog
spark.sql.catalogImplementation             hive
spark.hadoop.javax.jdo.option.ConnectionURL jdbc:derby:;databaseName=/tmp/part08-metastore;create=true
spark.sql.warehouse.dir                     s3a://larkspur-lake/delta/warehouse
spark.hadoop.fs.s3a.endpoint                http://seaweedfs:8333
spark.hadoop.fs.s3a.endpoint.region         us-east-1
spark.hadoop.fs.s3a.path.style.access       true
spark.hadoop.fs.s3a.connection.ssl.enabled  false
spark.hadoop.fs.s3a.access.key              __S3_ACCESS_KEY__
spark.hadoop.fs.s3a.secret.key              __S3_SECRET_KEY__
